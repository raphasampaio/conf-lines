{
	"name": "conf-lines",
	"version": "2.2.0",
	"description": "Simple JSON Lines config handling for your app or module",
	"license": "MIT",
	"repository": "raphasampaio/conf-lines",
	"author": "Raphael Sampaio (https://github.com/raphasampaio)",
	"type": "module",
	"exports": {
		"types": "./dist/source/index.d.ts",
		"default": "./dist/source/index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "xo && tsc --noEmit && tsx --test test/**.ts",
		"build": "del-cli dist && tsc",
		"prepare": "npm run build"
	},
	"files": [
		"dist/source"
	],
	"keywords": [
		"config",
		"store",
		"app",
		"storage",
		"conf",
		"configuration",
		"settings",
		"preferences",
		"json",
		"jsonl",
		"json-lines",
		"data",
		"persist",
		"persistent",
		"save",
		"load",
		"read",
		"write",
		"cache"
	],
	"dependencies": {
		"conf": "^16.0.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/node": "^26.6.3",
		"del-cli": "^7.0.0",
		"tempy": "^3.2.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"xo": "^1.2.2"
	},
	"xo": {
		"rules": {
			"@typescript-eslint/ban-ts-comment": "off",
			"unicorn/prevent-abbreviations": "off",
			"@typescript-eslint/no-floating-promises": "off"
		}
	}
}
